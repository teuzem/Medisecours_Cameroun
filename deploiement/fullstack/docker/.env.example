# .env.example — modèle des variables d'environnement de TON projet
#
# OÙ VIT LE .env FINAL : DANS LE DOSSIER docker/, À CÔTÉ de docker-compose.yml.
# docker compose lit automatiquement le .env du dossier qui contient le fichier
# compose (c'est le "dossier du projet") : si tu le poses ailleurs, compose
# n'en verra pas un seul et démarrera avec des vides.
#
# MODE D'EMPLOI
#   1. copie ce fichier :   cp docker/.env.example docker/.env
#   2. remplace CHAQUE {{...}} et CHAQUE CHANGE_ME (nano docker/.env)
#   3. ne commite JAMAIS docker/.env (ajoute `.env` à ton .gitignore) : il contient
#      les vrais mots de passe. Ce fichier .env.example, lui, n'en contient aucun.
#
# Deux familles de valeurs ici :
#   - les `{{...}}` sont remplacés à la main (ils apparaissent aussi dans les
#     fichiers nginx/ et les Dockerfiles) ;
#   - les autres sont lues automatiquement par `docker compose` (syntaxe ${VAR}).
#
# ⚠ CHEMINS RELATIFS : docker compose calcule tous les chemins depuis le dossier
#   docker/ (celui du compose). Les valeurs DOCKERFILE_BACKEND / DOCKERFILE_WS
#   commencent donc par "docker/" : elles sont résolues depuis la RACINE du
#   projet (= le `context: ..` du compose), pas depuis docker/.

# DOMAINE
# Nom de domaine principal : celui que les utilisateurs tapent dans le navigateur.
# Doit pointer (enregistrement A) vers {{IP_SERVEUR}} AVANT de lancer certbot,
# sinon la vérification HTTP-01 de Let's Encrypt échouera.
DOMAINE={{DOMAINE}}

# Sous-domaine de l'API. Si ton app utilise https://monapp.fr/api/... (même domaine),
# laisse {{DOMAINE_API}} identique à {{DOMAINE}}. S'il y a un vrai sous-domaine
# (api.monapp.fr), il faut aussi un enregistrement DNS A qui pointe vers le serveur.
DOMAINE_API={{DOMAINE_API}}

# Sous-domaine des WebSockets (wss://...). Identique à {{DOMAINE}} si tout passe
# par le même domaine via le chemin /ws.
DOMAINE_WS={{DOMAINE_WS}}

# Adresse IP du VPS, fournie par ton hébergeur. Elle ne sert que pour se
# connecter en SSH et pour créer l'enregistrement DNS A : jamais dans le code.
IP_SERVEUR={{IP_SERVEUR}}

# E-mail administrateur : reçu par Let's Encrypt pour les alertes d'expiration
# du certificat (30 jours avant). Utilise une boîte que tu consultes vraiment.
EMAIL_ADMIN={{EMAIL_ADMIN}}

# Nom court de ton projet : préfixe des conteneurs/volumes Docker.
# Minuscules, sans accent, sans espace (ex : monapp, medisecours).
NOM_PROJET={{NOM_PROJET}}

# PORTS
# Tous bindés en 127.0.0.1 dans docker-compose.yml : seuls ces ports-là sont
# utilisables, et uniquement par nginx sur le même hôte. Rien n'est exposé publiquement.
# Choisis des ports LIBRES : `sudo ss -ltn` liste les ports déjà occupés.
PORT_FRONTEND=3000
PORT_BACKEND=8000
PORT_WS=8081
# 5432 = PostgreSQL, 3306 = MySQL, 1521 = Oracle. Change si un service de l'hôte
# occupe déjà ce port (erreur "port is already allocated").
PORT_DB=5432

# BASE DE DONNÉES
# Nom de la base créée au premier démarrage du conteneur db.
DB_NAME=app
# Utilisateur applicatif (PAS root) : c'est celui que ton backend utilise au quotidien.
# Créer un utilisateur non-root limite les dégâts en cas de faille SQL dans l'app.
DB_USER=app

# Mot de passe de la base. GÉNÉRÉ, jamais inventé à la main :
#   openssl rand -hex 32
# → 64 caractères hexadécimaux, impossibles à deviner par force brute.
# Colle le résultat entre guillemets si tu changes de format plus tard.
MOT_DE_PASSE_DB=CHANGE_ME

# Quel moteur de base démarrer : postgres | mysql | oracle
# Un seul à la fois (ils se partagent PORT_DB). docker-compose.yml lit cette
# variable pour activer le bon `profiles`.
COMPOSE_PROFILES=postgres

# BACKEND (API REST)
# Secret applicatif : signature des sessions, des tokens JWT, du chiffrement.
# GÉNÉRATION (à faire une seule fois, puis JAMAIS changer en prod — sinon tous
# les utilisateurs sont déconnectés) :
#   openssl rand -base64 48
SECRET_APP=CHANGE_ME

# "1" = exécute les migrations de schéma au démarrage du conteneur backend.
# "0" = ne les exécute pas : tu les lances alors manuellement, à chaque mise à jour
#       (voir langages/*.md). En production très sensible, on préfère "0" pour
#       contrôler le moment exact où le schéma change.
RUN_MIGRATIONS=1

# Quel Dockerfile construire pour l'API (voir langages/README.md) :
#   docker/Dockerfile.backend-python | docker/Dockerfile.backend-php |
#   docker/Dockerfile.backend-java   | docker/Dockerfile.backend-node
# (chemin depuis la RACINE du projet, cf. en-tête du fichier)
DOCKERFILE_BACKEND=docker/Dockerfile.backend-python

# FRONTEND
# URL PUBLIQUE de l'API, c'est-à-dire celle que le navigateur de l'utilisateur
# appellera (https://...), pas l'adresse docker (http://backend:8000).
# Dans le navigateur, tout est https : sinon le navigateur bloque l'appel
# ("mixed content") quand la page est servie en HTTPS.
API_PUBLIC=https://{{DOMAINE_API}}

# WEBSOCKETS
# Fichier Dockerfile du service temps réel (souvent le même langage que l'API).
DOCKERFILE_WS=docker/Dockerfile.backend-node

# Secret PARTAGÉ entre l'API et le service ws : les deux doivent avoir la même
# valeur, sinon les tokens de session ne seront pas acceptés côté ws.
# Minimum 32 caractères — génère-le comme SECRET_APP :
#   openssl rand -base64 48
WS_SECRET=CHANGE_ME

# Origines autorisées à ouvrir un WebSocket (liste séparée par des virgules).
# Toute autre origine doit être refusée : sinon un site malveillant peut ouvrir
# une connexion temps réel au nom de tes utilisateurs.
WS_ORIGINS=https://{{DOMAINE}}
