# ============================================================================
# MediSecours+ — FRONTEND (Next.js) : variables de build
# ============================================================================
# À poser dans Coolify (onglet « Environment » du projet frontend), dans le
# fichier `medisecours-frontend/.env` pour un build local, ou en variables de
# build Docker (args du Dockerfile).
#
# ⚠ TOUTES ces valeurs sont lues AU MOMENT DU BUILD (next build). Modifier une
#   valeur ici impose un REBUILD — redémarrer le conteneur ne suffit pas.
#
# Fichiers équivalents déjà présents dans le dépôt :
#   - medisecours-frontend/.env.example   (commentaires détaillés, valeurs réelles)
#   - .env.production.example             (pile complète, voie docker-compose)
# ============================================================================

# ── Obligatoires ────────────────────────────────────────────────────────────

# URL cible du rewrite serveur /api/:path*. En compose, l'adresse interne
# du conteneur backend ; sur Coolify, l'URL publique de l'API.
# Ne JAMAIS préfixer par NEXT_PUBLIC_ (l'API serait appelée depuis le
# navigateur → mixed content / CORS en erreur).
API_BASE_URL=http://backend:10000
# API_BASE_URL=https://api.medisecours.batirlepays.com

# URL WebSocket publique, protocole wss:// (voir piège n°5 : sans cette
# valeur, le client retombe en ws://127.0.0.1:8081 → temps réel muet en prod).
NEXT_PUBLIC_WS_URL=wss://ws.medisecours.batirlepays.com/ws

# ── Cartographie : 3 providers, repli automatique (Google/Forge → Mapbox → Leaflet) ──

# Clé du proxy Frontend Forge (préférée, chiffrement clé côté serveur).
NEXT_PUBLIC_FRONTEND_FORGE_API_KEY=
NEXT_PUBLIC_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev

# Sinon clé Google Maps directe (Maps JavaScript API).
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Repli Mapbox (token public). Sans rien des trois → Leaflet, aucune clé.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# ── Optionnelles ────────────────────────────────────────────────────────────

# Connexion Google (OAuth). Laisser vide = pas de bouton Google.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Laisser VIDE en production : tout doit passer par le rewrite same-origin
# (sinon l'app appelle une autre origine → CORS). Uniquement pour dev/tests.
# NEXT_PUBLIC_API_BASE_URL=

# Clés serveur (jamais exposées au navigateur : lu par le routeur /api/cover-search).
# PEXELS_API_KEY=
# PIXABAY_API_KEY=

# ── Table des valeurs à personnaliser ───────────────────────────────────────
# | Valeur ce dépôt (référence)              | Pour ton projet          |
# |-------------------------------------------|--------------------------|
# | http://backend:10000 ou https://api.…     | API_BASE_URL             |
# | wss://ws.medisecours.batirlepays.com/ws   | NEXT_PUBLIC_WS_URL       |
# | https://forge.butterfly-effect.dev        | ta clé proxy ou Google   |
