# ============================================================================
# MediSecours+ — BACKEND (Symfony / PHP 8.3) : variables d'exécution
# ============================================================================
# À poser dans l'onglet « Environment » de Coolify, ou dans `.env` racine
# pour la voie `docker-compose.prod.yml`.
#
# ⚠ Ce sont des variables d'EXÉCUTION (sauf celles marquées build) : elles se
#   changent puis `docker compose up -d` (ou redeploy) — pas de rebuild.
#   Une valeur marquée `:?set in .env` FAIT ÉCHOUER le démarrage si absente.
#
# Fichiers équivalents déjà présents dans le dépôt :
#   - medisecours-backend/.env.coolify.example   (voie Coolify, commentariée)
#   - .env.production.example                    (voie compose, tout le stack)
# ============================================================================

# ── Application ─────────────────────────────────────────────────────────────
APP_ENV=prod
APP_DEBUG=0                          # 0 en prod : masque les traces d'erreur
APP_SECRET=                          # openssl rand -hex 32
APP_SHARE_DIR=/app/var
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
PORT=10000
DEFAULT_URI=https://api.medisecours.batirlepays.com

# ── Base de données ─────────────────────────────────────────────────────────
# Compose : host DNS du service db. Coolify : nom de la ressource Postgres.
# SSL sur hébergeur managé (Neon, RDS…) → sslmode=require
DATABASE_URL=postgresql://medisecours:MOT_DE_PASSE_DB@db:5432/medisecours?sslmode=disable

# 1 = database/schema.sql + seed.sql importés AVANT le 1er boot → on saute les
# migrations Doctrine. 0 (défaut) = l'entrypoint applique tout seul.
# Mélanger les deux = erreur « table existe déjà ».
SKIP_MIGRATIONS=0
STRICT_DATABASE_BOOTSTRAP=0

# ── Données de référence (catalogue santé) ──────────────────────────────────
BOOTSTRAP_REFERENCE_DATA=1
STRICT_REFERENCE_DATA_BOOTSTRAP=0
REFERENCE_DATA_VERSION=2026-08-07.1

# ── CORS / front ────────────────────────────────────────────────────────────
# REGEX ancrée et échappée — jamais de '*'.
CORS_ALLOW_ORIGIN=^https://medisecours\.batirlepays\.com$
FRONTEND_URL=https://medisecours.batirlepays.com

# ── JWT (obligatoire : le boot refuse de démarrer sans) ─────────────────────
# Générer UNE paire, la stocker secrète, ne jamais la committer :
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#     -out private.pem -passout "pass:<JWT_PASSPHRASE>"
#   openssl rsa -in private.pem -pubout \
#     -passin "pass:<JWT_PASSPHRASE>" -out public.pem
JWT_SECRET_KEY=/app/config/jwt/private.pem
JWT_PUBLIC_KEY=/app/config/jwt/public.pem
JWT_PRIVATE_KEY_BASE64=              # base64 -w 0 private.pem
JWT_PUBLIC_KEY_BASE64=               # base64 -w 0 public.pem
JWT_PASSPHRASE=
JWT_TTL=7200

# ── Temps réel : publication vers le service WebSocket ──────────────────────
# Le backend y POSTe chaque évènement ; sans secret partagé, le service le
# rejette → plus aucun temps réel (symptôme discret, voir ws/README).
WS_PUBLISH_URL=https://ws.medisecours.batirlepays.com/publish
# En compose : http://ws:8081/publish (adresse interne)
WS_PUBLISH_SECRET=                   # 32+ caractères, identique côté service ws

# ── Carte Santé : sync Google Places (temps réel) ───────────────────────────
# Sans aucune clé → sync désactivée (configured=false), aucune erreur.
FORGE_API_URL=https://forge.butterfly-effect.dev
FORGE_API_KEY=
# GOOGLE_MAPS_API_KEY=               # variante sans proxy Forge
SYNC_STRUCTURES_INTERVAL_MIN=30      # 0 = jamais (sinon : boot + toutes les N min)
SYNC_STRUCTURES_CAP=400
LOAD_CENTRES=0                       # 1 = seed legacy des 232 mock (déconseillé)

# ── Connexion Google (optionnelle) ──────────────────────────────────────────
# GOOGLE_CLIENT_ID=

# ── Mailer (Brevo SMTP) ─────────────────────────────────────────────────────
# SMTP_KEY doit être URL-encodée (les ':' et '+' posent problème sinon).
MAILER_DSN=smtp://SMTP_LOGIN:SMTP_KEY_URL_ENCODEE@smtp-relay.brevo.com:587
MAILER_SENDER_EMAIL=no-reply@medisecours.batirlepays.com
MAILER_SENDER_NAME=MediSecours

# ── Premier admin (UNIQUEMENT premier boot) ─────────────────────────────────
# Créé au démarrage, puis RETIRER ces deux variables (UI + compose) :
# les laisser posées = un compte admin se recrée à chaque redéploiement.
# CREATE_ADMIN_EMAIL=admin@example.com
# CREATE_ADMIN_PASSWORD=
