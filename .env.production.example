# ============================================================================
# MediSecours+ — consolidated production environment (Compose / VPS)
# ============================================================================
# Copy to `.env` and fill every `<...>` placeholder:
#   cp .env.production.example .env
# Do NOT commit the real .env — it is gitignored.
# ============================================================================

# ── Postgres (compose db service) ────────────────────────────────────────
POSTGRES_USER=medisecours
POSTGRES_PASSWORD=<CHANGE_ME_STRONG_DB_PASSWORD>
POSTGRES_DB=medisecours

# Backend connection string (compose service DNS = "db").
# For Coolify-managed Postgres replace the host with the resource name.
DATABASE_URL=postgresql://medisecours:<CHANGE_ME_STRONG_DB_PASSWORD>@db:5432/medisecours?sslmode=disable

# ── Security ─────────────────────────────────────────────────────────────
APP_SECRET=<openssl rand -hex 32>
JWT_PRIVATE_KEY_BASE64=<cat private.pem | base64 -w0>
JWT_PUBLIC_KEY_BASE64=<cat public.pem | base64 -w0>
JWT_PASSPHRASE=<your-jwt-key-passphrase>
JWT_TTL=7200
WS_PUBLISH_SECRET=<32+ random chars — same value for backend + ws>

# ── Domains ──────────────────────────────────────────────────────────────
FRONTEND_URL=https://medisecours.batirlepays.com
DEFAULT_URI=https://api.medisecours.batirlepays.com
CORS_ALLOW_ORIGIN=^https://medisecours\.batirlepays\.com$

# ── Frontend ─────────────────────────────────────────────────────────────
# Public URLs. With compose, API_BASE_URL can stay internal (http://backend:10000).
API_BASE_URL=http://backend:10000
NEXT_PUBLIC_WS_URL=wss://ws.medisecours.batirlepays.com/ws

# ── WebSocket (ws service) ───────────────────────────────────────────────
WS_ALLOWED_ORIGINS=https://medisecours.batirlepays.com

# ── Carte Santé : synchronisation temps réel (Google Places) ─────────────
# BACKEND container. Proxy Frontend Forge — noms identiques au projet de
# référence Manus (BUILT_IN_FORGE_API_URL / BUILT_IN_FORGE_API_KEY) ou noms app
# (FORGE_API_URL / FORGE_API_KEY) — ou clé Google Maps "Places API" serveur.
# Sans aucune clé, le sync ne modifie rien (configured=false).
FORGE_API_URL=https://forge.butterfly-effect.dev
FORGE_API_KEY=<your-frontend-forge-api-key>
# GOOGLE_MAPS_API_KEY=<your-key-if-no-forge>
# Données réelles Google en temps réel : 1ère passe au boot puis toutes les N
# minutes. 0 = jamais (lancer app:carte:sync-structures à la main / cron).
SYNC_STRUCTURES_INTERVAL_MIN=30
SYNC_STRUCTURES_CAP=400
# Legacy (déconseillé) : seed des 232 mock data à chaque boot. Utiliser plutôt
# le sync Google Places ci-dessus + purge des source='manuel' :
#   DELETE FROM centre_de_sante WHERE source='manuel';
LOAD_CENTRES=0

# FRONTEND container — build-time, Next.js inline NEXT_PUBLIC_*. Même clé que
# FORGE_API_KEY (Google Maps chargé via le proxy Manus/Forge). Les noms exacts
# du projet de référence Manus (VITE_FRONTEND_FORGE_API_KEY / _URL) sont aussi
# acceptés au build.
NEXT_PUBLIC_FRONTEND_FORGE_API_KEY=<your-frontend-forge-api-key>
NEXT_PUBLIC_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=<your-key-if-no-forge>

# ── Reference data ───────────────────────────────────────────────────────
BOOTSTRAP_REFERENCE_DATA=1
REFERENCE_DATA_VERSION=2026-08-07.1

# ── Google OAuth (optional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=

# ── Mailer (Brevo) ───────────────────────────────────────────────────────
MAILER_DSN=smtp://<SMTP_LOGIN>:<URL_ENCODED_SMTP_KEY>@smtp-relay.brevo.com:587
MAILER_SENDER_EMAIL=no-reply@medisecours.batirlepays.com
MAILER_SENDER_NAME=MediSecours

# ── First admin (remove after first boot) ────────────────────────────────
CREATE_ADMIN_EMAIL=
CREATE_ADMIN_PASSWORD=