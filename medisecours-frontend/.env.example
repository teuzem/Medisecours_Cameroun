# Server-only URL used by the Next.js rewrite. Do not prefix it with
# NEXT_PUBLIC_ in Vercel/Netlify.
# Coolify: point to the public API domain so the server-side rewrite works.
API_BASE_URL=https://api.medisecours.batirlepays.com

# Browser-visible values.
NEXT_PUBLIC_WS_URL=wss://ws.medisecours.batirlepays.com/ws
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id

# Optional — set only for direct browser-to-API calls (bypassing the rewrite).
# In production this is usually left unset so everything stays same-origin
# through the /api rewrite.
# NEXT_PUBLIC_API_BASE_URL=https://api.medisecours.batirlepays.com

# ─── Cartographie (module Carte Santé) ───────────────────────────────────────
# Fournisseur par défaut : Google Maps via le proxy officiel Frontend Forge
# (intégration Manus). Sinon clé Google Maps directe. Sans aucune clé, la carte
# bascule automatiquement sur le repli Leaflet (aucune clé nécessaire).
#
# Clé du proxy Frontend Forge : ignorée si non définie.
# NEXT_PUBLIC_FRONTEND_FORGE_API_KEY=your-forge-api-key
# URL de base du proxy (optionnelle, valeur par défaut ci-dessous).
# NEXT_PUBLIC_FRONTEND_FORGE_API_URL=https://forge.butterfly-effect.dev
#
# Clé Google Maps directe (Maps JavaScript API) : utilisée si aucune clé Forge.
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
