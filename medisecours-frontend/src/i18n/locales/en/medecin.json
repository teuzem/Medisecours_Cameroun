      "faqEyebrow": "Frequently asked questions",
      "faqTitle": "Doctor FAQ",
      "faq1": {
        "q": "How to accept a consultation?",
        "a": "Go to the Consultations tab, find the pending request and click \"Accept\". A discussion space opens automatically."
      },
      "faq2": {
        "q": "How to create a prescription?",
        "a": "Go to Prescriptions then click \"New prescription\". Fill in the diagnosis, medications with dosage, then sign and transmit to the patient."
      },
      "faq3": {
        "q": "Can I cancel a transmitted prescription?",
        "a": "Yes. On an active prescription, click \"Cancel\" and indicate the reason. The patient will be notified of the cancellation."
      },
      "faq4": {
        "q": "How to replace an existing prescription?",
        "a": "On an active prescription, click \"Replace\". A new pre-filled prescription is created that you can modify before signing."
      },
      "faq5": {
        "q": "How to access reports?",
        "a": "Use the \"Reports\" link in the sidebar. You'll find detailed statistics on your activity and that of your center."
      },
      "faq6": {
        "q": "Is my data secure?",
        "a": "Yes. All medical data is encrypted and complies with confidentiality standards. Only the patients concerned and authorized administrators can access it."
      },
