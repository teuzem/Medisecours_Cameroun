# ============================================================================
# MediSecours+ — Symfony public/.htaccess for Hostinger (Apache 2.4+)
# ============================================================================
# Place this file in your deployed copy of medisecours-backend/public/.
# Hostinger shared hosting uses Apache + mod_rewrite; this file enables
# the Symfony front controller pattern and hardens the public directory.
# ============================================================================

<IfModule mod_rewrite.c>
    RewriteEngine On

    # If the request matches a real file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    # Everything else goes to the Symfony front controller
    RewriteRule ^ index.php [L]
</IfModule>

# Deny access to dotfiles and hidden files except .well-known (Let's Encrypt)
<IfModule mod_authz_core.c>
    <FilesMatch "^\.">
        <RequireAll>
            <RequireAny>
                <RequireEnv REDIRECT_STATUS=200
            </RequireAny>
        </RequireAll>
    </FilesMatch>
</IfModule>

<IfModule !mod_authz_core.c>
    <FilesMatch "^\.">
        Order deny,allow
        Deny from all
    </FilesMatch>
</FilesMatch>

# Deny access to sensitive configuration files
<FilesMatch "^(\.env|\.env\..*|composer\..*|\.git|\.gitignore|phpunit\.xml|phpstan\.neon)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Deny access to the config/jwt directory
<IfModule mod_rewrite.c>
    RewriteRule ^config/jwt/ - [F,L]
</IfModule>

# Prevent directory listing
Options -Indexes
