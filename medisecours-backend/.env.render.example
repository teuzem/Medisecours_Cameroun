APP_ENV=prod
APP_DEBUG=0
APP_SECRET=generate-a-long-random-value
APP_SHARE_DIR=/app/var
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
DEFAULT_URI=https://medisecours-backend.onrender.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
BOOTSTRAP_REFERENCE_DATA=1
REFERENCE_DATA_VERSION=2026-08-07.1
CORS_ALLOW_ORIGIN=^https://your-project\.vercel\.app$
FRONTEND_URL=https://your-project.vercel.app

JWT_SECRET_KEY=/app/config/jwt/private.pem
JWT_PUBLIC_KEY=/app/config/jwt/public.pem
JWT_PRIVATE_KEY_BASE64=base64-encoded-private-pem
JWT_PUBLIC_KEY_BASE64=base64-encoded-public-pem
JWT_PASSPHRASE=your-jwt-key-passphrase
JWT_TTL=7200

WS_PUBLISH_URL=provided-by-render-blueprint
WS_PUBLISH_SECRET=shared-long-random-secret

GOOGLE_CLIENT_ID=your-google-client-id
MAILER_DSN=smtp://SMTP_LOGIN:URL_ENCODED_SMTP_KEY@smtp-relay.brevo.com:587
MAILER_SENDER_EMAIL=no-reply@example.com
MAILER_SENDER_NAME=MediSecours
