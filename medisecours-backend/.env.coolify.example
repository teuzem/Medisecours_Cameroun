# ============================================================================
# MediSecours+ backend — environment variables for Coolify
# ============================================================================
# Fill every value marked <…> before creating the Coolify resource.
# Coolify reads this file as documentation; actual values go into the
# Coolify "Environment" tab or Docker Compose config.
#
# Quick path: copy every value into Coolify's UI for the medisecours-backend
# application.  All <…> placeholders MUST be replaced before deploy.
# ============================================================================

# ── App --------------------------------------------------------------------
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=<32-char random string: openssl rand -hex 32>
APP_SHARE_DIR=/app/var
TRUSTED_PROXIES=127.0.0.1,REMOTE_ADDR
DEFAULT_URI=https://api.medisecours.batirlepays.com
PORT=10000

# ── Database ----------------------------------------------------------------
# Coolify self-hosted Postgres 16:
DATABASE_URL=postgresql://medisecours:<CHANGE_ME>@medisecours-db:5432/medisecours?sslmode=disable

# Neon alternative (sslmode=require):
# DATABASE_URL=postgresql://user:pass@ep-xxx.eu-central-1.aws.neon.tech/medisecours?sslmode=require

# Set to 1 if you imported database/schema.sql + seed.sql BEFORE the first
# deploy.  Leave at 0 (or unset) for an empty database — the entrypoint will
# run all Doctrine migrations automatically.
# SKIP_MIGRATIONS=0
SKIP_MIGRATIONS=0

# ── Reference data bootstrap ------------------------------------------------
BOOTSTRAP_REFERENCE_DATA=1
STRICT_REFERENCE_DATA_BOOTSTRAP=0
REFERENCE_DATA_VERSION=2026-08-07.1

# ── CORS / Frontend ---------------------------------------------------------
CORS_ALLOW_ORIGIN=^https://medisecours\.batirlepays\.com$
FRONTEND_URL=https://medisecours.batirlepays.com

# ── JWT ---------------------------------------------------------------------
# Generate a fresh keypair ONCE and store the values here:
#   openssl genpkey -out /tmp/jwt/private.pem -outform PEM \
#       -algorithm RSA -pkeyopt rsa_keygen_bits:2048 \
#       -passout "pass:<JWT_PASSPHRASE>"
#   openssl rsa -in /tmp/jwt/private.pem -pubout \
#       -passin "pass:<JWT_PASSPHRASE>" -out /tmp/jwt/public.pem
#
#   base64 -w 0 /tmp/jwt/private.pem
#   base64 -w 0 /tmp/jwt/public.pem
JWT_SECRET_KEY=/app/config/jwt/private.pem
JWT_PUBLIC_KEY=/app/config/jwt/public.pem
JWT_PRIVATE_KEY_BASE64=<base64-encoded private.pem>
JWT_PUBLIC_KEY_BASE64=<base64-encoded public.pem>
JWT_PASSPHRASE=<passphrase used to generate the key>
JWT_TTL=7200

# ── WebSocket publishing ----------------------------------------------------
# Points to the public URL of the WebSocket service.
# The backend POSTs real-time events here with X-WS-Publish-Secret.
WS_PUBLISH_URL=https://ws.medisecours.batirlepays.com/publish
WS_PUBLISH_SECRET=<32+ random characters — shared with the WS service>

# ── Google OAuth (optional) -------------------------------------------------
# GOOGLE_CLIENT_ID=

# ── Carte Santé — sync temps réel des structures (Google Places) ------------
# Proxy Forge Géopôle — noms exacts du projet de référence Manus
# (BUILT_IN_FORGE_API_URL / BUILT_IN_FORGE_API_KEY) ou noms app
# (FORGE_API_URL / FORGE_API_KEY) — ou clé Google Maps serveur.
FORGE_API_URL=https://forge.butterfly-effect.dev
# FORGE_API_KEY=<clé Forge — côté frontend préfixée NEXT_PUBLIC_FRONTEND_FORGE_API_KEY>
# GOOGLE_MAPS_API_KEY=<clé Google Maps serveur> (si pas de proxy Forge)
# Données réelles Google en temps réel : 1ère passe au boot puis toutes les N
# minutes. 0 = jamais.
SYNC_STRUCTURES_INTERVAL_MIN=30
SYNC_STRUCTURES_CAP=400
# Legacy (déconseillé) : seed des 232 mock data à chaque boot.
LOAD_CENTRES=0

# ── Mailer (Brevo SMTP relay) -----------------------------------------------
MAILER_DSN=smtp://<SMTP_LOGIN>:<URL_ENCODED_SMTP_KEY>@smtp-relay.brevo.com:587
MAILER_SENDER_EMAIL=no-reply@medisecours.batirlepays.com
MAILER_SENDER_NAME=MediSecours

# ── First admin (created at boot) -------------------------------------------
# Set these temporarily on first deploy, then remove from Coolify UI once
# the admin account exists.
# CREATE_ADMIN_EMAIL=you@example.com
# CREATE_ADMIN_PASSWORD=YourSecurePassword123!
